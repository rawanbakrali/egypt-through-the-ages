<tr data-id="<%= place.compositeId %>">
  <td>
    <div class="cell-media">
      <img src="<%= place.image %>" alt="<%= place.name %>" class="cell-thumb" />
      <div class="cell-info"><span class="cell-title"><%= place.name %></span></div>
    </div>
  </td>
  <td><%= place.eraName %> — <%= place.categoryLabel %></td>
  <% if (typeof showLocation !== 'undefined' && showLocation) { %>
    <td><%= place.location %></td>
  <% } %>
  <td>
    <span class="status-badge <%= place.status === 'published' ? 'badge-published' : 'badge-draft' %>" data-action="toggle-place-status" data-id="<%= place.compositeId %>">
      <%= place.status === 'published' ? 'Published' : 'Draft' %>
    </span>
  </td>
  <td><%= place.updatedAt %></td>
  <td>
    <div class="action-group">
      <button class="action-btn" title="Edit Place" data-action="edit-place" data-id="<%= place.compositeId %>">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </button>
      <button class="action-btn delete" title="Delete Place" data-action="delete-place" data-id="<%= place.compositeId %>" data-name="<%= place.name %>">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      </button>
    </div>
  </td>
</tr>