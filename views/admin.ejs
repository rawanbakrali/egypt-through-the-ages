<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/drawer.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
</head>
<body>

  <div class="admin-layout">
    <!-- ==========================================
         SIDEBAR NAVIGATION
         ========================================== -->
    <aside class="admin-sidebar">
      <div class="sidebar-header">
        <a href="/admin" class="sidebar-logo">EGYPT</a>
        <div class="sidebar-subtitle">THROUGH THE AGES</div>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section-label">Main</div>
        <a class="nav-item is-active" data-view="overview">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Dashboard</span>
        </a>

        <div class="nav-section-label">Content</div>
        <a class="nav-item" data-view="places">
          <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Historical Places</span>
        </a>
        <a class="nav-item" data-view="events">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>Events</span>
        </a>
        <a class="nav-item" data-view="bookings">
          <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>Event Bookings</span>
        </a>

        <div class="nav-section-label">Manage</div>
        <a class="nav-item" data-view="users">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Users</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <button class="logout-btn" id="adminLogoutBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Log Out</span>
        </button>
      </div>
    </aside>

    <!-- ==========================================
         MAIN CANVAS
         ========================================== -->
    <main class="admin-main">
      <!-- HEADER BAR -->
      <header class="admin-header">
        <div class="header-left">
          <h1 class="header-title" id="currentViewTitle">Dashboard</h1>
        </div>

        <div class="header-right">
          <div class="header-search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="globalAdminSearch" placeholder="Search dashboard...">
          </div>

          <div class="user-badge">
            <div class="user-avatar">A</div>
            <span class="user-name">Admin</span>
          </div>
        </div>
      </header>

      <!-- CONTENT BODY -->
      <div class="admin-content">
        <!-- ==========================================
             VIEW 1: OVERVIEW DASHBOARD
             ========================================== -->
        <section class="view-section is-active" id="view-overview">
          <div class="section-overview-intro">
            <h2>Overview</h2>
            <p>Manage historical places, events, and bookings.</p>
          </div>

          <!-- TOP 2-COLUMN GRID -->
          <div class="dashboard-grid">
            
            <!-- HISTORICAL PLACES CARD -->
            <div class="admin-card">
              <div class="card-header">
                <h3 class="card-title">Historical Places</h3>
                <button class="btn btn-primary btn-sm btn-open-add-place">
                  <span>Add New Place</span>
                </button>
              </div>

              <div class="table-responsive">
                <table class="admin-table" id="tablePlacesOverview">
                  <thead>
                    <tr>
                      <th>PLACE</th>
                      <th>CATEGORY</th>
                      <th>STATUS</th>
                      <th>UPDATED</th>
                      <th>ACTIONS</th>
                    </tr>
                  </thead>
                 <tbody>
                    <% places.slice(0, 3).forEach(place => { %>
                    <%- include('partials/place-row', { place: place, showLocation: false }) %><% }); %>
                  </tbody>
                </table>
              </div>

              <div class="card-footer">
                <a class="view-all-link" onclick="switchAdminView('places')">
                  <span>View all places</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>

            <!-- EVENTS CARD -->
            <div class="admin-card">
              <div class="card-header">
                <div class="card-title-wrap">
                  <h3 class="card-title">Events</h3>
                  <div class="card-tabs">
                    <button class="tab-btn is-active" onclick="filterOverviewEvents('all', this)">All Events</button>
                    <button class="tab-btn" onclick="filterOverviewEvents('submission', this)">Submissions</button>
                    <button class="tab-btn" onclick="filterOverviewEvents('featured', this)">Featured</button>
                  </div>
                </div>
                <button class="btn btn-primary btn-sm btn-open-add-event">
                  <span>Add Official Event</span>
                </button>
              </div>

              <div class="table-responsive">
                <table class="admin-table" id="tableEventsOverview">
                  <thead>
                    <tr>
                      <th>EVENT</th>
                      <th>TYPE</th>
                      <th>STATUS</th>
                      <th>DATE</th>
                      <th>ACTIONS</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% events.slice(0, 3).forEach(event => { %>
                    <%- include('partials/event-row', { event: event, variant: 'overview' }) %><% }); %>
                  </tbody>
                </table>
              </div>

              <div class="card-footer">
                <a class="view-all-link" onclick="switchAdminView('events')">
                  <span>View all events</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- FULL-WIDTH EVENT BOOKINGS CARD -->
          <div class="dashboard-full-width">
            <div class="admin-card">
              <div class="card-header">
                <div class="card-title-wrap">
                  <h3 class="card-title">Event Bookings</h3>
                  <div class="card-tabs">
                    <button class="tab-btn is-active" onclick="filterOverviewBookings('all', this)">All Bookings</button>
                    <button class="tab-btn" onclick="filterOverviewBookings('open', this)">Open</button>
                    <button class="tab-btn" onclick="filterOverviewBookings('reserved', this)">Reserved</button>
                    <button class="tab-btn" onclick="filterOverviewBookings('full', this)">Full</button>
                  </div>
                </div>
                <button class="btn btn-primary btn-sm" onclick="switchAdminView('bookings')">
                  <span>View All Bookings</span>
                </button>
              </div>

              <div class="table-responsive">
                <table class="admin-table" id="tableBookingsOverview">
                  <thead>
                    <tr>
                      <th>BOOKING ID</th>
                      <th>EVENT</th>
                      <th>BOOKED BY</th>
                      <th>DATE</th>
                      <th>STATUS</th>
                      <th>TICKETS</th>
                      <th>ACTIONS</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% bookings.slice(0, 3).forEach(b => { %>
                    <%- include('partials/booking-row', { b: b, variant: 'overview' }) %><% }); %>
                  </tbody>
                </table>
              </div>

              <div class="card-footer">
                <a class="view-all-link" onclick="switchAdminView('bookings')">
                  <span>View all bookings</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </div>

        </section>

        <!-- ==========================================
             VIEW 2: HISTORICAL PLACES FULL VIEW
             ========================================== -->
        <section class="view-section" id="view-places">
          <div class="admin-card">
            <div class="card-header">
              <h3 class="card-title">All Historical Places Management</h3>
              <button class="btn btn-primary btn-sm btn-open-add-place">Add New Place</button>
            </div>
            <div class="table-responsive">
              <table class="admin-table" id="tablePlacesFull">
                <thead>
                  <tr>
                    <th>PLACE</th>
                    <th>CATEGORY / ERA</th>
                    <th>LOCATION</th>
                    <th>STATUS</th>
                    <th>UPDATED</th>
                    <th>ACTIONS</th>
                  </tr>
                </thead>
                <tbody>
                  <% places.forEach(place => { %>
                  <%- include('partials/place-row', { place: place, showLocation: true }) %><% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ==========================================
             VIEW 3: EVENTS MANAGEMENT FULL VIEW
             ========================================== -->
        <section class="view-section" id="view-events">
          <div class="admin-card">
            <div class="card-header">
              <div class="card-title-wrap">
                <h3 class="card-title">Events Management & Review Queue</h3>
                <div class="card-tabs">
                  <button class="tab-btn is-active" onclick="switchEventSubTab('all', this)">All Events</button>
                  <button class="tab-btn" onclick="switchEventSubTab('official', this)">Official Events</button>
                  <button class="tab-btn" onclick="switchEventSubTab('submission', this)">Submissions Queue</button>
                </div>
              </div>
              <button class="btn btn-primary btn-sm btn-open-add-event">Add Official Event</button>
            </div>
            <div class="table-responsive">
              <table class="admin-table" id="tableEventsFull">
                <thead>
                  <tr>
                    <th>EVENT TITLE</th>
                    <th>TYPE</th>
                    <th>CATEGORY</th>
                    <th>LOCATION</th>
                    <th>DATE</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                  </tr>
                </thead>
                <tbody>
                  <% events.forEach(event => { %>
                  <%- include('partials/event-row', { event: event, variant: 'full' }) %><% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ==========================================
             EVENT BOOKINGS FULL VIEW
             ========================================== -->
        <section class="view-section" id="view-bookings">
          <div class="admin-card">
            <div class="card-header">
              <h3 class="card-title">All Event Bookings & Status Overrides</h3>
            </div>
            <div class="table-responsive">
              <table class="admin-table" id="tableBookingsFull">
                <thead>
                  <tr>
                    <th>BOOKING ID</th>
                    <th>EVENT</th>
                    <th>BOOKED BY</th>
                    <th>EMAIL</th>
                    <th>DATE</th>
                    <th>TICKETS</th>
                    <th>TOTAL</th>
                    <th>BOOKING STATUS</th>
                    <th>ACTIONS</th>
                  </tr>
                </thead>
                <tbody>
                  <% bookings.forEach(b => { %>
                  <%- include('partials/booking-row', { b: b, variant: 'full' }) %><% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- OTHER MANAGE VIEWS -->
        <section class="view-section" id="view-users">
          <div class="admin-card">
            <div class="card-header">
              <h3 class="card-title">User Management</h3>
            </div>
            <div class="table-responsive">
              <table class="admin-table" id="tableUsers">
                <thead>
                  <tr>
                    <th>USERNAME</th>
                    <th>EMAIL</th>
                    <th>ROLE</th>
                    <th>JOINED</th>
                    <th>ACTIONS</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                  <tr data-id="<%= u.id %>">
                    <td><span class="cell-title"><%= u.username %></span></td>
                    <td><%= u.email %></td>
                    <td>
                      <span class="status-badge <%= u.role === 'admin' ? 'badge-published' : 'badge-draft' %>">
                        <%= u.role === 'admin' ? 'Admin' : 'User' %>
                      </span>
                    </td>
                    <td><%= u.joined %></td>
                    <td>
                      <div class="action-group">
                        <button class="action-btn" title="Edit User" data-action="edit-user" data-id="<%= u.id %>">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>
                        <button class="action-btn delete" title="Delete User" data-action="delete-user" data-id="<%= u.id %>" data-name="<%= u.username %>">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>

        <%- include('partials/footer') %>
        <%- include('partials/auth-modal') %>

    </main>
  </div>

  <!-- EDIT HISTORICAL PLACE -->
  <div class="modal-backdrop" id="modalPlace">
    <div class="white-modal">
      <div class="modal-header">
        <h3 class="modal-title" id="modalPlaceTitle">Add New Historical Place</h3>
        <button class="modal-close-btn" onclick="closeModal('modalPlace')">&times;</button>
      </div>
      <form id="formPlace" onsubmit="handlePlaceFormSubmit(event)">
        <div class="modal-body">
          <input type="hidden" id="placeFormId" value="">
          <input type="hidden" id="placeFormOriginalName" value="">
          <div class="form-grid">
            <div class="form-group full-width">
              <label class="form-label">Place Name</label>
              <input type="text" id="placeFormName" class="form-input" placeholder="e.g. Citadel of Saladin" required>
            </div>
            <div class="form-group">
              <label class="form-label">Era</label>
              <select id="placeFormEra" class="form-select" onchange="populateCategoryOptions()">
                <option value="">Select an era</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Category</label>
              <select id="placeFormCategory" class="form-select">
                <option value="">Select an era first</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Status</label>
              <select id="placeFormStatus" class="form-select">
                <option value="published">Published</option>
                <option value="draft">Draft</option>
              </select>
            </div>
            <div class="form-group full-width">
              <label class="form-label">Location</label>
              <input type="text" id="placeFormLocation" class="form-input" placeholder="e.g. Cairo, Egypt" required>
            </div>
            <div class="form-group full-width">
              <label class="form-label">Map Position</label>
              <p class="form-hint">Click the map to set the exact location.</p>
              <div id="placeFormMap" class="form-map"></div>
              <input type="hidden" id="placeFormLat" value="">
              <input type="hidden" id="placeFormLng" value="">
            </div>
            <div class="form-group full-width">
              <label class="form-label">Image</label>
              <input type="file" id="placeFormImageFile" class="form-input" accept="image/*">
              <input type="hidden" id="placeFormImage" value="">
              <img id="placeFormImagePreview" src="" alt="Current image" style="display:none; max-width:140px; margin-top:10px; border-radius:8px;">
            </div>
            <div class="form-group full-width">
              <label class="form-label">Description</label>
              <textarea id="placeFormDescription" class="form-textarea" placeholder="Brief historical overview..."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('modalPlace')">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Place</button>
        </div>
      </form>
    </div>
  </div>

  
  <div class="modal-backdrop" id="modalEvent">
    <div class="white-modal">
      <div class="modal-header">
        <h3 class="modal-title" id="modalEventTitle">Add Official Event</h3>
        <button class="modal-close-btn" onclick="closeModal('modalEvent')">&times;</button>
      </div>
      <form id="formEvent" onsubmit="handleEventFormSubmit(event)">
        <div class="modal-body">
          <input type="hidden" id="eventFormSlug" value="">
          <div class="form-grid">
            <div class="form-group full-width">
              <label class="form-label">Event Title</label>
              <input type="text" id="eventFormTitle" class="form-input" placeholder="e.g. Cairo International Film Festival" required>
            </div>
            <div class="form-group">
              <label class="form-label">Type</label>
              <select id="eventFormType" class="form-select">
                <option value="official">Official</option>
                <option value="business">Business</option>
                <option value="community">Community</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Category</label>
              <input type="text" id="eventFormCategory" class="form-input" placeholder="e.g. Sound & Light" required>
            </div>
            <div class="form-group">
              <label class="form-label">Date</label>
              <input type="date" id="eventFormDate" class="form-input" required>
            </div>
            <div class="form-group">
              <label class="form-label">Booking Status</label>
              <select id="eventFormBookingStatus" class="form-select">
                <option value="open">Open</option>
                <option value="reserved">Reserved</option>
                <option value="full">Full</option>
              </select>
            </div>
            <div class="form-group full-width">
              <label class="form-label">Location</label>
              <input type="text" id="eventFormLocation" class="form-input" placeholder="e.g. Cairo Opera House" required>
            </div>
            <div class="form-group full-width">
              <label class="form-label">Map Position</label>
              <p class="form-hint">Click the map to set the exact location.</p>
              <div id="eventFormMap" class="form-map"></div>
              <input type="hidden" id="eventFormLat" value="">
              <input type="hidden" id="eventFormLng" value="">
            </div>
            <div class="form-group full-width">
              <label class="form-label">Image</label>
              <input type="file" id="eventFormImageFile" class="form-input" accept="image/*">
              <input type="hidden" id="eventFormImage" value="">
              <img id="eventFormImagePreview" src="" alt="Current image" style="display:none; max-width:140px; margin-top:10px; border-radius:8px;">
            </div>
            <div class="form-group full-width">
              <label class="form-label">Description</label>
              <textarea id="eventFormDescription" class="form-textarea" placeholder="Event details and details..."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('modalEvent')">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Event</button>
        </div>
      </form>
    </div>
  </div>

  <!-- EDIT USER -->
  <div class="modal-backdrop" id="modalUser">
    <div class="white-modal" style="max-width: 440px;">
      <div class="modal-header">
        <h3 class="modal-title">Edit User</h3>
        <button class="modal-close-btn" onclick="closeModal('modalUser')">&times;</button>
      </div>
      <form id="formUser" onsubmit="handleUserFormSubmit(event)">
        <div class="modal-body">
          <input type="hidden" id="userFormId" value="">
          <div class="form-grid">
            <div class="form-group full-width">
              <label class="form-label">Username</label>
              <input type="text" id="userFormUsername" class="form-input" required>
            </div>
            <div class="form-group full-width">
              <label class="form-label">Email</label>
              <input type="email" id="userFormEmail" class="form-input" required>
            </div>
            <div class="form-group full-width">
              <label class="form-label">Role</label>
              <select id="userFormRole" class="form-select">
                <option value="user">User</option>
                <option value="admin">Admin</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('modalUser')">Cancel</button>
          <button type="submit" class="btn btn-primary">Save User</button>
        </div>
      </form>
    </div>
  </div>

  <!-- OVERRIDE BOOKING STATUS-->
  <div class="modal-backdrop" id="modalBooking">
    <div class="white-modal" style="max-width: 440px;">
      <div class="modal-header">
        <h3 class="modal-title">Override Booking Status</h3>
        <button class="modal-close-btn" onclick="closeModal('modalBooking')">&times;</button>
      </div>
      <form id="formBookingOverride" onsubmit="handleBookingOverrideSubmit(event)">
        <div class="modal-body">
          <input type="hidden" id="overrideBookingId" value="">
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            Override booking state for <strong id="overrideBookingIdLabel" style="color: var(--text-main);">#BK1258</strong>.
          </p>
          <div class="form-group">
            <label class="form-label">Select Status Badge</label>
            <select id="overrideBookingSelect" class="form-select">
              <option value="open">Open (Green Badge)</option>
              <option value="reserved">Reserved (Blue Badge)</option>
              <option value="full">Full (Red Badge)</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('modalBooking')">Cancel</button>
          <button type="submit" class="btn btn-primary">Apply Status</button>
        </div>
      </form>
    </div>
  </div>

  <!-- REVIEW SUBMISSION QUEUE  -->
  <div class="modal-backdrop" id="modalSubmission">
    <div class="white-modal">
      <div class="modal-header">
        <h3 class="modal-title">Review Submission</h3>
        <button class="modal-close-btn" onclick="closeModal('modalSubmission')">&times;</button>
      </div>
      <div class="modal-body">
        <div id="submissionReviewContent">
          <!-- Dynamic contents inserted via JS -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" onclick="handleRejectSubmission()">Reject</button>
        <button type="button" class="btn btn-secondary" onclick="handleEditSubmission()">Edit Submission</button>
        <button type="button" class="btn btn-primary" onclick="handleApproveSubmission()">Approve & Publish</button>
      </div>
    </div>
  </div>

  <!--  DELETE CONFIRMATION MODAL  -->
  <div class="modal-backdrop" id="modalDelete">
    <div class="white-modal" style="max-width: 420px;">
      <div class="modal-header">
        <h3 class="modal-title">Confirm Deletion</h3>
        <button class="modal-close-btn" onclick="closeModal('modalDelete')">&times;</button>
      </div>
      <div class="modal-body">
        <p style="font-size: 0.9rem; color: var(--text-main);">
          Are you sure you want to delete <strong id="deleteTargetName">Item</strong>? This action cannot be undone.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('modalDelete')">Cancel</button>
        <button type="button" class="btn btn-danger" onclick="executeDelete()">Delete</button>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT DATA CONTAINERS (XSS SAFE) -->
  <script type="application/json" id="admin-events-data"><%- JSON.stringify(events) %></script>
  <script type="application/json" id="era-category-map-data"><%- JSON.stringify(eraCategoryMap) %></script>
  <script type="application/json" id="admin-places-data"><%- JSON.stringify(places) %></script>
  <script type="application/json" id="admin-users-data"><%- JSON.stringify(users) %></script>

  <script>
    window.ADMIN_EVENTS = JSON.parse(document.getElementById('admin-events-data').textContent);
    window.ERA_CATEGORY_MAP = JSON.parse(document.getElementById('era-category-map-data').textContent);
    window.ADMIN_PLACES = JSON.parse(document.getElementById('admin-places-data').textContent);
    window.ADMIN_USERS = JSON.parse(document.getElementById('admin-users-data').textContent);
  </script>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/auth.js"></script>
  <script src="/js/auth-guard.js"></script>
</body>
</html>