<!-- views/error.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/drawer.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <section style="min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 80px 5%;">
        <span class="small-label" style="margin-bottom: 20px;">SOMETHING WENT WRONG</span>
        <h1 class="hero-title" style="margin-bottom: 20px;">An unexpected error occurred</h1>
        <p class="body-text-secondary" style="max-width: 480px; margin-bottom: 40px;">
            <%= message %>
        </p>
        <a href="/" class="btn-outline">RETURN HOME &rarr;</a>
    </section>

    <%- include('partials/footer') %>
    <%- include('partials/auth-modal') %>

    <script src="/js/auth.js"></script>
    <script src="/js/auth-guard.js"></script>
</body>
</html>